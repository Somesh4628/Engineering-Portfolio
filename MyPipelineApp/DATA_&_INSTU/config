def build_system_graph(bp):
    """(Universal Topology Engine v1.1)
    Analyzes a v4.0 blueprint and now correctly associates pipes with sensors.
    """
    print(" -> Executing Universal Topology Engine (v1.1)...")
    nodes_map, pipes = {n['node_id']: n for n in bp.get('nodes', [])}, bp.get('pipes', [])
    sensors_ordered, s_map = [], {}

    # --- Pass 1: Sensor Indexing (REPAIRED) ---
    for p in pipes:
        if 'flow_sensor' in p:
            s_data, s_id = p['flow_sensor'], p['flow_sensor'].get('sensor_id')
            if not s_id or s_id in s_map: raise ValueError(f"Invalid sensor ID in pipe {p.get('pipe_id')}")
            idx, label = len(sensors_ordered), s_data.get('label', s_id)
            s_map[s_id] = idx
            sensors_ordered.append({
                'id': s_id,
                'pin': s_data.get('gpio_pin'),
                'k_factor': s_data.get('k_factor_ppl'),
                'label': label,
                'pipe_id': p.get('pipe_id') # <<<--- THE CRITICAL FIX IS HERE
            })

    # The rest of the function remains the same and is correct.
    io = {nid: {'in': [], 'out': []} for nid in nodes_map}
    for p in pipes:
        if 'flow_sensor' in p:
            idx = s_map[p['flow_sensor']['sensor_id']]
            if p['source_node'] in io: io[p['source_node']]['out'].append(idx)
            if p['target_node'] in io: io[p['target_node']]['in'].append(idx)

    balance_nodes = [{'id': nid, 'inflows': sorted(d['in']), 'outflows': sorted(d['out'])} for nid, d in io.items() if d['in'] or d['out']]
    
    print(f" -> Topology analysis complete. Discovered {len(balance_nodes)} nodes and {len(sensors_ordered)} sensors.")
    return {'sensors_ordered': sensors_ordered, 'balance_nodes': balance_nodes}


