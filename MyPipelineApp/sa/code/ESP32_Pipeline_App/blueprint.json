      {
        "id_ui_hint": "Sensor_Outlet_S2",
        "gpio_pin": 17
      }
    ]
  },
  "minor_loss_coefficients": {
    "k_90_elbow": 0.9,
    "k_45_elbow": 0.4,
    "k_tee_branch": 1.8,
